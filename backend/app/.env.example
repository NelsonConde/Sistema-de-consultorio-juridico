# Ejemplo de variables de entorno del backend. Sustituya los marcadores por valores propios del entorno.
# Spring Boot no carga automáticamente este archivo desde backend/app.
# Para ejecutar desde una terminal o IDE, configure las variables en el entorno del proceso.
# Si utiliza el docker-compose.yml de la raíz, proporcione las variables mediante el entorno o un archivo .env situado en la raíz del proyecto.
# No versione archivos .env con valores reales.

# PostgreSQL — sin valor predeterminado en la configuración versionada
DB_URL=jdbc:postgresql://<db-host>:5432/<db-name>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>

# Autenticación y CORS — sin valor predeterminado en la configuración versionada
JWT_SECRET=<generate-a-random-secret>
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Correo transaccional — sin valor predeterminado en la configuración versionada
BREVO_API_KEY=<brevo-api-key>
MAIL_FROM_EMAIL=<verified-sender@example.invalid>

# Almacenamiento privado — sin valor predeterminado en la configuración versionada
SUPABASE_STORAGE_ENDPOINT=https://<project-id>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=<storage-region>
SUPABASE_STORAGE_ACCESS_KEY=<storage-access-key>
SUPABASE_STORAGE_SECRET_KEY=<storage-secret-key>

# Opcionales — se muestran los valores predeterminados versionados
PORT=8080
DB_DDL_AUTO=validate
DB_SHOW_SQL=false
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_HIBERNATE_SQL=WARN
LOG_LEVEL_HIBERNATE_BIND=WARN
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAME_SITE=None
FRONTEND_URL=http://localhost:3000
SUPABASE_STORAGE_BUCKET=legal-documents
FILE_UPLOAD_URL_VALIDITY=PT10M
FILE_DOWNLOAD_URL_VALIDITY=PT5M
